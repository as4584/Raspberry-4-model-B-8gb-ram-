# Never commit real credentials or voice recordings.
RECEPTIONIST_DB=./data/receptionist.sqlite
DEV_ALLOW_UNSIGNED=1
VOICE_BACKEND=mock
PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_WSS_URL=wss://your-domain.example/twilio/media
# Twilio (S7). Real values live ONLY in Doppler project pi-receptionist,
# config prd, injected at runtime: doppler run -- <command>. Never fill these here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# To enable Pi-only local speech when actual binaries/models are installed:
# VOICE_BACKEND=local
# WHISPER_CLI=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/models/ggml-tiny.en.bin
# PIPER_CLI=/opt/piper/piper
# PIPER_MODEL=/opt/models/en_US-lessac-medium.onnx
