[Unit]
Description=Render receptionist secrets from Doppler (read-only prd token) into RAM
Wants=network-online.target
After=network-online.target
Before=asterisk.service pi-receptionist.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Root-only token file; systemd reads it, the token never reaches a command line.
EnvironmentFile=/etc/pi-receptionist/doppler.env
# doppler needs a HOME for its CLI config; give it the unit's own private state dir.
Environment=HOME=/var/lib/pi-receptionist/secrets
# --fallback keeps an encrypted local copy so the Pi still boots if Doppler is unreachable.
ExecStart=/usr/bin/doppler run --fallback /var/lib/pi-receptionist/secrets/doppler-fallback.json -- /opt/pi-receptionist/app/scripts/render_secrets.sh
StateDirectory=pi-receptionist/secrets
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
