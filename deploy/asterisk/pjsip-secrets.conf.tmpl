; Rendered into /run/asterisk-secrets (tmpfs) from Doppler. Never written to disk or git.
[telnyx-auth]
type = auth
auth_type = userpass
username = ${TELNYX_SIP_USERNAME}
password = ${TELNYX_SIP_PASSWORD}

[telnyx-reg]
type = registration
transport = transport-tls
outbound_auth = telnyx-auth
server_uri = sip:sip.telnyx.com:5061;transport=tls
client_uri = sip:${TELNYX_SIP_USERNAME}@sip.telnyx.com;transport=tls
contact_user = ${TELNYX_SIP_USERNAME}
retry_interval = 30
forbidden_retry_interval = 300
expiration = 600
line = yes
endpoint = telnyx
