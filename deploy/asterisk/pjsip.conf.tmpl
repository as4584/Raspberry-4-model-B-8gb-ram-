; Rendered to /etc/asterisk/pjsip.conf by scripts/pi_install_asterisk.sh with values
; from Doppler. Never commit the rendered file.
[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060

; --- Telnyx SIP connection (credentials auth, registration keeps NAT open) ---
[telnyx-auth]
type = auth
auth_type = userpass
username = ${TELNYX_SIP_USERNAME}
password = ${TELNYX_SIP_PASSWORD}

[telnyx-aor]
type = aor
contact = sip:sip.telnyx.com:5060

[telnyx-reg]
type = registration
transport = transport-udp
outbound_auth = telnyx-auth
server_uri = sip:sip.telnyx.com
client_uri = sip:${TELNYX_SIP_USERNAME}@sip.telnyx.com
retry_interval = 60

[telnyx]
type = endpoint
transport = transport-udp
context = from-telnyx
disallow = all
allow = ulaw
outbound_auth = telnyx-auth
aors = telnyx-aor
direct_media = no
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes

[telnyx-identify]
type = identify
endpoint = telnyx
match = sip.telnyx.com

; --- Local SIPp test caller (no provider, no minutes) ---
[sipp]
type = endpoint
transport = transport-udp
context = from-sipp
disallow = all
allow = ulaw
direct_media = no

[sipp-identify]
type = identify
endpoint = sipp
match = 127.0.0.1
